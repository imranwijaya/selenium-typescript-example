{
  "name": "selenium-typescript-example",
  "version": "1.0.0",
  "description": "Selenium WebDriver Typescript using Page Object Models",
  "main": "index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "npx tsc",
    "pretest": "npm run build",
    "test": "mocha",
    "pretest:chrome": "npm run build",
    "test:chrome": "cross-env BROWSER_ENV=true BROWSER_NAME=chrome mocha",
    "pretest:firefox": "npm run build",
    "test:firefox": "cross-env BROWSER_ENV=true BROWSER_NAME=firefox mocha"
  },
  "keywords": [
    "selenium",
    "node",
    "typescript"
  ],
  "author": "Imran Wijaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imranwijaya/selenium-typescript-example.git"
  },
  "license": "ISC",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/selenium-webdriver": "^4.1.29",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chai": "^5.3.3",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "mocha": "^11.8.0",
    "mochawesome": "^7.1.3",
    "prettier": "^3.8.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^6.0.1",
    "selenium-webdriver": "^4.47.0",
    "typescript": "^5.9.3"
  }
}
