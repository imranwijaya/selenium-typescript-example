{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@config/*": [
        "./config/*"
      ],
      "@lib/*": [
        "./lib/*"
      ],
      "@pages/*": [
        "./pages/*"
      ],
      "@repositories/*": [
        "./repositories/*"
      ]
    }
  },
  "include": [
    "*.ts",
    "config/**/*.ts",
    "repositories/**/*.ts",
    "lib/**/*.ts",
    "pages/**/*.ts",
    "repositories/**/*.ts",
    "specs/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}